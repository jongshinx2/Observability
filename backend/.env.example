# Copy to backend/.env. Process environment overrides matching file keys.
# .env.example itself is NOT loaded. Restart the backend after settings changes.
# OpenAI-compatible LLM (Ollama or external vLLM)
SRELENS_LLM_BASE_URL=https://192.168.50.181/v1
# Legacy SRELENS_OLLAMA_BASE_URL remains supported when the new URL is absent.
# External authenticated server: set the key via a secret/environment variable.
# SRELENS_LLM_API_KEY=
# No-auth remote server must explicitly opt in (do not expose it publicly):
# SRELENS_LLM_AUTH_MODE=none
SRELENS_MODEL_NAME=qwen3.6:9b
# Optional role overrides; absent/empty values inherit SRELENS_MODEL_NAME.
# SRELENS_ORCHESTRATOR_MODEL=
# SRELENS_QUERY_MODEL=
# SRELENS_SYNTHESIZER_MODEL=

# Reasoning mode: omit | effort | chat_template. No automatic retries with changed modes.
# When unset: orchestrator/query omit; synthesizer sends reasoning_effort=none (legacy).
# Global override applies to all roles unless a role-specific override is set.
# SRELENS_LLM_REASONING_MODE=effort
# SRELENS_LLM_REASONING_EFFORT=none
# For templates that support enable_thinking instead of reasoning_effort:
# SRELENS_LLM_REASONING_MODE=chat_template
# SRELENS_LLM_ENABLE_THINKING=false
# Optional role overrides: SRELENS_{ORCHESTRATOR,QUERY,SYNTHESIZER}_REASONING_MODE
# and _REASONING_EFFORT / _ENABLE_THINKING.
SRELENS_ORCHESTRATOR_MAX_TOKENS=1024
SRELENS_QUERY_MAX_TOKENS=512
SRELENS_SYNTHESIZER_MAX_TOKENS=512
SRELENS_LLM_TIMEOUT=120
SRELENS_LLM_CONNECT_TIMEOUT=5
SRELENS_LLM_MAX_RETRIES=2

# Cross-datasource correlation limits
SRELENS_CORRELATION_MAX_HOPS=4
SRELENS_CORRELATION_BUFFER_SECONDS=120
SRELENS_CORRELATION_MAX_TRACE_IDS=10
SRELENS_CORRELATION_MAX_SERVICES=10
SRELENS_CORRELATION_MAX_SPAN_IDS=100

# Observability data sources
SRELENS_PROMETHEUS_URL=http://localhost:9090/api/v1/query
SRELENS_LOKI_URL=http://localhost:3100/loki/api/v1/query_range
SRELENS_TEMPO_URL=http://localhost:3200/api/traces

# API and safety limits
SRELENS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SRELENS_REQUEST_TIMEOUT=5
SRELENS_MAX_ITERATIONS=5
SRELENS_MAX_STEPS=3
SRELENS_MAX_OUTPUT_CHARS=2000

# Application logs (set SRELENS_LOG_FILE= to disable file logging)
SRELENS_LOG_LEVEL=INFO
SRELENS_LOG_FORMAT=json
SRELENS_LOG_FILE=logs/srelens.log
