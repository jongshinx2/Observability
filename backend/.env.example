# Local LLM
SRELENS_OLLAMA_BASE_URL=http://localhost:11434/v1
SRELENS_MODEL_NAME=qwen3.5:9b
SRELENS_ORCHESTRATOR_MODEL=qwen3.5:9b
SRELENS_QUERY_MODEL=qwen3.5:9b
SRELENS_SYNTHESIZER_MODEL=qwen3.5:9b
SRELENS_SYNTHESIZER_REASONING_EFFORT=none
SRELENS_SYNTHESIZER_MAX_TOKENS=512
SRELENS_LLM_TIMEOUT=120

# Cross-datasource correlation limits
SRELENS_CORRELATION_MAX_HOPS=4
SRELENS_CORRELATION_BUFFER_SECONDS=120
SRELENS_CORRELATION_MAX_TRACE_IDS=10
SRELENS_CORRELATION_MAX_SERVICES=10
SRELENS_CORRELATION_MAX_SPAN_IDS=100

# Observability data sources
SRELENS_PROMETHEUS_URL=http://localhost:9090/api/v1/query
SRELENS_LOKI_URL=http://localhost:3100/loki/api/v1/query_range
SRELENS_TEMPO_URL=http://localhost:3200/api/traces

# API and safety limits
SRELENS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SRELENS_REQUEST_TIMEOUT=5
SRELENS_MAX_ITERATIONS=5
SRELENS_MAX_STEPS=3
SRELENS_MAX_OUTPUT_CHARS=2000

# Application logs (set SRELENS_LOG_FILE= to disable file logging)
SRELENS_LOG_LEVEL=INFO
SRELENS_LOG_FORMAT=json
SRELENS_LOG_FILE=logs/srelens.log
